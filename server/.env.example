# EcoRecife · API: modelo de configuração.
# Copie para ".env" (que NUNCA é versionado) e troque os valores.
#   PowerShell:  Copy-Item .env.example .env

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da API (o front, em desenvolvimento, usa a 5173)
PORTA=3333

# Conexão com o PostgreSQL. Troque USUARIO e SENHA pelos seus.
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/ecorecife

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173

# Opcional, só para os testes de integração (pnpm test):
# conexão com um usuário que possa criar bancos (CREATEDB). Os testes criam e
# apagam um banco temporário "ecorecife_teste_..." e não tocam no banco acima.
# TEST_DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/postgres
